# Backend
# Debug value for api server use it as 0 for production use
DEBUG=0
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3100"

# Nama host yang boleh melayani request. Django menolak `Host:` di luar daftar
# ini dengan 400 Bad Request. Kosong berarti `*` (lihat settings/common.py).
#
# ⚠️ Tiap kali menambah nama host di SITE_ADDRESS (.env root), nama itu WAJIB
# ikut ditambahkan di sini. Kalau terlewat, gejalanya menyesatkan: halaman `/`
# tetap 200 karena itu cuma cangkang SPA, tapi setiap panggilan API membalas
# 400 dan aplikasinya tidak jalan sama sekali lewat nama baru itu. Yang memakai
# alamat lama tidak terpengaruh, jadi masalahnya mudah luput dari pengujian.
# Sudah kejadian 12 Agt 2026.
#
# Pertahankan alamat lama di daftar supaya akses lewat IP tidak ikut mati:
#   ALLOWED_HOSTS=space.paradiseperkasa.com,128.159.110.5,localhost
#
# ⚠️ NAMA CONTAINER `api` WAJIB IKUT, dan ini yang paling mudah terlewat.
# `live` memanggil API lewat `http://api:8000` (lihat API_BASE_URL di compose),
# jadi Host yang dikirim adalah `api:8000`, bukan nama domain. Tanpa `api` di
# daftar ini, Django membalas 400 untuk SETIAP panggilan antar-container.
#
# Gejalanya jahat karena tidak terlihat sebagai kerusakan: aplikasi terbuka
# normal, semua halaman 200, tapi kolaborasi Pages dan obrolan real-time diam
# total. Soket menutup sambungan dengan "Tidak berhak" bahkan untuk orang yang
# benar-benar berhak, dan tidak ada satu pun error yang menunjuk ke sini.
# Sudah kejadian 18 Agt 2026, ketahuan hanya karena diuji dengan sesi sungguhan.
#
#   ALLOWED_HOSTS=space.paradiseperkasa.com,128.159.110.5,localhost,api
#
# Bawaannya `*` supaya menyamai default kode; template tidak boleh lebih ketat
# dari kodenya, kalau tidak instalasi baru mati sendiri di request pertama.
# Persempit di produksi, tapi sebutkan SEMUA nama yang benar-benar dipakai,
# termasuk nama internal antar-container.
ALLOWED_HOSTS="*"

# Database Settings
POSTGRES_USER="plane"
POSTGRES_PASSWORD="plane"
POSTGRES_HOST="plane-db"
POSTGRES_DB="plane"
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis Settings
REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://${REDIS_HOST}:6379/"

# RabbitMQ Settings
RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="plane"
RABBITMQ_VHOST="plane"

# AWS Settings
AWS_REGION=""
AWS_ACCESS_KEY_ID="access-key"
AWS_SECRET_ACCESS_KEY="secret-key"
AWS_S3_ENDPOINT_URL="http://localhost:9000"
# Changing this requires change in the proxy config for uploads if using minio setup
AWS_S3_BUCKET_NAME="uploads"
# Maximum file upload limit
FILE_SIZE_LIMIT=5242880
# Signed URL expiration time in seconds (default: 3600 = 1 hour)
# Set to 30 for 30 seconds, 300 for 5 minutes, etc.
SIGNED_URL_EXPIRATION=3600

# Settings related to Docker
DOCKERIZED=1 # deprecated

# set to 1 If using the pre-configured minio setup
USE_MINIO=0



# Email redirections and minio domain settings
WEB_URL="http://localhost:8000"

# Gunicorn Workers
GUNICORN_WORKERS=2

# Base URLs
ADMIN_BASE_URL="http://localhost:3001"
ADMIN_BASE_PATH="/god-mode"

SPACE_BASE_URL="http://localhost:3002"
SPACE_BASE_PATH="/spaces"

APP_BASE_URL="http://localhost:3000"
APP_BASE_PATH=""

LIVE_BASE_URL="http://localhost:3100"
LIVE_BASE_PATH="/live"

LIVE_SERVER_SECRET_KEY="secret-key"

# Sinkronisasi Google Calendar. MATI secara bawaan karena fitur ini menulis ke
# kalender pribadi orang; menyalakannya harus tindakan sadar, bukan efek samping
# sebuah deploy. Sesudah diubah wajib `docker compose up -d`, karena `restart`
# tidak membaca ulang env file.
ENABLE_GOOGLE_CALENDAR_SYNC=0

# Kredensial OAuth untuk Google Calendar. Boleh diisi di sini, atau di God Mode
# yang menang atas nilai ini. SENGAJA terpisah dari GOOGLE_CLIENT_ID milik login
# Google: keduanya butuh scope berbeda, dan menggabungkannya berarti setiap
# orang yang login lewat Google ikut dimintai izin kalender.
#
# Di Google Cloud Console: aktifkan Google Calendar API, buat OAuth Client ID
# tipe Web, lalu daftarkan Authorized redirect URI PERSIS seperti ini:
#   https://<host>/api/google-calendar/callback/
# Beda satu garis miring pun ditolak `redirect_uri_mismatch`, dan pesannya tidak
# menyebut bagian mana yang berbeda.
#
# ⚠️ Akun non-Workspace: scope kalender menuntut verifikasi aplikasi oleh Google.
# Tanpa verifikasi, batasnya 100 pengguna dan setiap orang melihat layar
# peringatan "Google belum memverifikasi aplikasi ini" saat menyambungkan.
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""

# Berapa lama barang ter-soft-delete disimpan sebelum dibuang permanen oleh
# tugas harian. Nilai inilah yang menentukan isi Trashbin per project dan TPA
# di God Mode.
#
# HARUS SAMA dengan .env.example di root. Keduanya pernah menyimpang: root
# diturunkan ke 30 oleh commit 641bed9 sedangkan berkas ini tertinggal di 60,
# dan server diprovisikan dari berkas ini sehingga produksi diam-diam berjalan
# di 60 selama dua belas hari tanpa ada yang menyadarinya.
#
# Menurunkannya membuat barang yang sudah lewat batas baru langsung terbuang
# pada jalan berikutnya. Periksa dulu isinya sebelum mengecilkan angka ini.
HARD_DELETE_AFTER_DAYS=30

# Force HTTPS for handling SSL Termination
MINIO_ENDPOINT_SSL=0

# API key rate limit
API_KEY_RATE_LIMIT="60/minute"

# Frasa konfirmasi untuk MEMBERI Super Admin dari God Mode (God Mode -> Member).
# Kosong/tidak diset = pemberian Super Admin DITOLAK. Isi dengan frasa milikmu
# sendiri; jangan pernah menaruh frasa sungguhan di berkas ini (ter-track git).
SUPER_ADMIN_GRANT_PASSPHRASE=""
